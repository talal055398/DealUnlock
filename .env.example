# Lemon Squeezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# رابط الموقع بعد النشر على Vercel (بدون / بالنهاية)
NEXT_PUBLIC_URL=https://your-app.vercel.app

# قاعدة البيانات — اتركه فارغ محلياً (سيستخدم SQLite تلقائياً)
# على Vercel: فعّل Vercel Postgres وسيضاف هذا المتغير تلقائياً
DATABASE_URL=

# سر حماية رابط الـ cron — أي قيمة عشوائية طويلة تختارها بنفسك.
# نفس القيمة لازم تكون موجودة بمتغيرات البيئة، وVercel يرسلها تلقائياً
# كـ Authorization header عند تشغيل الـ cron المجدول.
CRON_SECRET=

# AliExpress Affiliate API — للجلب التلقائي اليومي للعروض.
# تقدّم من https://portals.aliexpress.com (يوم إلى يومين للموافقة عادة،
# بدون شرط مبيعات مسبقة، على عكس Amazon).
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
